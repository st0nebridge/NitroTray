{
  "name": "nitrotray",
  "version": "0.1.2",
  "description": "Compact NitroSense tray companion for Acer Nitro laptops: telemetry, fan and performance modes, graph tray icons.",
  "author": "Brandon Stonebridge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/st0nebridge/NitroTray.git"
  },
  "homepage": "https://github.com/st0nebridge/NitroTray",
  "private": true,
  "main": "src/main.rs",
  "type": "module",
  "scripts": {
    "build": "cargo build --release --bins",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File bin/package.ps1",
    "test": "cargo test --all-targets && node --test \"tests/ui/**/*.test.mjs\"",
    "test:ui": "node --test \"tests/ui/**/*.test.mjs\"",
    "coverage": "cargo llvm-cov --all-targets --summary-only && node --test --experimental-test-coverage \"tests/ui/**/*.test.mjs\"",
    "start": "cargo run --bin NitroTray",
    "helper:console": "cargo run --bin NitroTrayService -- console",
    "preview": "node bin/devserver.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "jsdom": "^30.1.1"
  }
}
